<!-- The classpath: includes need a Spring-style resource accessor (Spring Boot's Liquibase
     integration). Other runners may silently skip them. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="classpath:org/jwcarman/who/jdbc/db/who-jdbc-changelog.xml" errorIfMissing="false"/>
    <include file="classpath:org/jwcarman/who/rbac/db/who-rbac-changelog.xml" errorIfMissing="false"/>
    <include file="classpath:org/jwcarman/who/jwt/db/who-jwt-changelog.xml" errorIfMissing="false"/>
    <include file="classpath:org/jwcarman/who/enrollment/db/who-enrollment-changelog.xml" errorIfMissing="false"/>
    <include file="classpath:org/jwcarman/who/apikey/db/who-apikey-changelog.xml" errorIfMissing="false"/>
    <include file="classpath:org/jwcarman/who/emaillink/db/who-email-link-changelog.xml" errorIfMissing="false"/>

</databaseChangeLog>
