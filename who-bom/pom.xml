<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.who</groupId>
        <artifactId>who-parent</artifactId>
        <version>0.12.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>who-bom</artifactId>
    <packaging>pom</packaging>

    <name>Who - BOM</name>
    <description>Bill of Materials for Who: version alignment for consumers</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-rbac</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-spring-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-jwt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-enrollment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-apikey</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-email-link</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-passkey</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jwcarman.who</groupId>
                <artifactId>who-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Flattened on the way out, and only this module is.

        Importing a BOM pulls in its *effective* dependencyManagement, after inheritance, and
        who-parent imports spring-boot-dependencies for its own build. Published as-is, this BOM
        would re-export all of Spring Boot's managed versions, so a consumer importing it to align
        who's artifacts would have its Spring Boot, Jackson and JUnit versions decided for it too.

        bom mode writes the pom that is installed and deployed without the parent and with only
        the dependencyManagement declared here. The build still inherits normally, so
        versions:set, the sonar: prefix and the formatting and license checks all reach this
        module like any other.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
