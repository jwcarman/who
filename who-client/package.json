{
  "name": "@jwcarman/who-client",
  "version": "0.0.0-dev",
  "description": "A typed TypeScript client for who's browser endpoints",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwcarman/who.git",
    "directory": "who-client"
  },
  "homepage": "https://github.com/jwcarman/who#readme",
  "bugs": "https://github.com/jwcarman/who/issues",
  "keywords": [
    "who",
    "authentication",
    "passkeys",
    "webauthn",
    "spring-security"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --emitDeclarationOnly && vite build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "format": "lint-tools/node_modules/.bin/prettier --write .",
    "format:check": "lint-tools/node_modules/.bin/prettier --check .",
    "lint": "lint-tools/node_modules/.bin/eslint -c lint-tools/eslint.config.mjs ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "jsdom": "31.0.0",
    "msw": "3.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
