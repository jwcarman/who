<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.who</groupId>
        <artifactId>who-parent</artifactId>
        <version>0.17.0-SNAPSHOT</version>
    </parent>

    <artifactId>who-native-tests</artifactId>
    <packaging>pom</packaging>

    <name>Who - Native Tests</name>
    <description>One small app per sign-in method, built native and driven over HTTP. Never published.</description>

    <modules>
        <module>native-test-support</module>
        <module>native-email-link</module>
        <module>native-passkey</module>
        <module>native-api-key</module>
        <module>native-jwt</module>
    </modules>

    <properties>
        <!-- Test apps, never published or installed, and not library code. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <skipPitest>true</skipPitest>
        <sonar.skip>true</sonar.skip>
        <!-- Spring Boot 4.1.2's native-build-tools-plugin.version; who-parent imports Boot's BOM,
             which manages dependencies only, so the plugin version is pinned here. -->
        <native-build-tools.version>1.1.14</native-build-tools.version>
    </properties>

    <profiles>
        <!-- -Dnative: Spring AOT, then GraalVM compiles the app at package, and each *IT drives the
             binary (app.binary) instead of starting the app in its own JVM. Needs GraalVM 25 as JAVA_HOME.
             Apps set start-class; native-test-support has no main class and opts out. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                                <configuration>
                                    <mainClass>${start-class}</mainClass>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-build-tools.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <mainClass>${start-class}</mainClass>
                            <imageName>${project.artifactId}</imageName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>add-reachability-metadata</id>
                                <goals>
                                    <goal>add-reachability-metadata</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <app.binary>${project.build.directory}/${project.artifactId}</app.binary>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
